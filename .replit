modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Kontra Preview"

[[workflows.workflow]]
name = "Kontra Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd kontra-ui-clone && (PORT=3001 npm --prefix api start > /tmp/kontra-api.log 2>&1 &) && VITE_API_PROXY_PORT=3001 PORT=5000 npm --prefix ui run dev -- --host 0.0.0.0"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 5000

[nix]
channel = "stable-25_05"
