{
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kontra-api.onrender.com/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ],
  "env": {
    "VITE_API_BASE_URL": "https://kontra-api.onrender.com",
    "VITE_API_URL": "https://kontra-api.onrender.com",
    "VITE_SUPABASE_URL": "https://jfhojgtnmcfqretrrxam.supabase.co",
    "VITE_SENTRY_DSN": "<your-dsn>",
    "VITE_NEW_DASH": "true"
  },
  "_deployTrigger": "1783396800000"
}
